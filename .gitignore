# .gitignore: files and folders that git should NOT track. Each line is a pattern; a
# trailing / means "a folder", * matches anything, ** matches any depth of sub-folders,
# and a line starting with ! is an exception ("do track this after all").

# Python build leftovers and the virtual environment (recreated with pip install)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
build/
dist/

# Runtime data: ignored except the example shopping list
data/*
!data/shopping_list.example.yaml
!data/replay/
data/replay/*
!data/replay/README.md

# Model weights are large: ignore them, keep eval reports
models/**/*.pt
models/**/*.onnx
models/**/*.weights
models/**/*.json
!models/**/eval_report*.md
models/voices/
runs/
*.pt
yolo*.pt

# Operating-system and editor clutter
.DS_Store
Thumbs.db
.idea/
.vscode/

# the released model is small enough to version (TR-15)
!models/grocereye_a/best.pt
!models/grocereye_a/results.csv
!models/grocereye_p6k2/best.pt
!models/grocereye_p6k2/results.csv
